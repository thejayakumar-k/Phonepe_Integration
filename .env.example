# OORUNII Payment Configuration
# Copy this file to .env and fill in your values

# ── PhonePe (Direct UPI) ──────────────────────────────────────────
# Merchant UPI ID (from PhonePe Business account)
VITE_MERCHANT_UPI_ID=your-merchant@phonepe

# Merchant display name
VITE_MERCHANT_NAME=OORUNII Store

# Payment session duration in minutes (default: 10)
VITE_PAYMENT_SESSION_MINUTES=10

# App URL (for callbacks)
VITE_APP_URL=http://localhost:5173

# ── PayU Payment Gateway ──────────────────────────────────────────
# Get credentials from https://dashboard.payu.in
VITE_PAYU_MERCHANT_KEY=your_payu_merchant_key
VITE_PAYU_MERCHANT_SALT=your_payu_merchant_salt

# Environment: 'sandbox' (test) or 'production' (live)
VITE_PAYU_ENV=sandbox

# ── Supabase (Database / Backend) ───────────────────────────────────
# Get these from your Supabase project: Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# ── Chat Assistant (Cloudflare Worker) ──────────────────────────────
# URL of the deployed OORUNII chat worker (local dev: http://localhost:8787)
VITE_CHAT_API_URL=http://localhost:8787

